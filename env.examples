# ── LLM Keys ──────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Zaggle API ─────────────────────────────────────
ZAGGLE_API_BASE_URL=https://api.zaggle.in/v1
ZAGGLE_API_KEY=your_zaggle_api_key_here
ZAGGLE_CLIENT_ID=your_zaggle_client_id_here
ZAGGLE_CLIENT_SECRET=your_zaggle_client_secret_here

# ── ERP Integration ────────────────────────────────
ERP_API_BASE_URL=https://your-erp-instance/api
ERP_API_KEY=your_erp_api_key_here
ERP_COMPANY_CODE=COMP001

# ── GSTN API ───────────────────────────────────────
GSTN_API_URL=https://api.gst.gov.in
GSTN_USERNAME=your_gstn_username
GSTN_APP_KEY=your_gstn_app_key

# ── Database ───────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cfoos
REDIS_URL=redis://localhost:6379/0

# ── App Config ─────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000env
